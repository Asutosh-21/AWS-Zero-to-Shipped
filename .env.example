# Environment variable templates — copy and fill in your values

# ── Lambda Environment Variables ─────────────────────────────────────────────
# Set these in AWS Console → Lambda → Configuration → Environment variables

BEDROCK_AGENT_SUPERVISOR_ID=REPLACE_WITH_AGENT_ID
BEDROCK_AGENT_SUPERVISOR_ALIAS=LIVE
BEDROCK_KB_ID=REPLACE_WITH_KB_ID
BEDROCK_KB_DATASOURCE_ID=REPLACE_WITH_DATASOURCE_ID

DYNAMODB_TABLE_USERS=nutriroute-prod-users
DYNAMODB_TABLE_SOURCES=nutriroute-prod-food-sources
DYNAMODB_TABLE_INVENTORY=nutriroute-prod-inventory
DYNAMODB_TABLE_TRUST=nutriroute-prod-trust-scores
DYNAMODB_TABLE_NUTRI=nutriroute-prod-nutri-scores

LOCATION_MAP_NAME=nutriroute-prod-map
LOCATION_ROUTER_NAME=nutriroute-prod-router
LOCATION_PLACE_INDEX=nutriroute-prod-places
LOCATION_GEOFENCE_COLLECTION=nutriroute-prod-geofences

S3_BUCKET_IMAGES=nutriroute-prod-food-images-REPLACE_ACCOUNT_ID
S3_BUCKET_UPLOADS=nutriroute-prod-user-uploads-REPLACE_ACCOUNT_ID
S3_BUCKET_DOCS=nutriroute-prod-usda-docs-REPLACE_ACCOUNT_ID

SNS_TOPIC_ARN=arn:aws:sns:us-east-1:REPLACE_ACCOUNT_ID:nutriroute-prod-alerts
ELASTICACHE_ENDPOINT=REPLACE_WITH_ELASTICACHE_ENDPOINT

# ── Frontend Web (.env.local) ─────────────────────────────────────────────────
# Create frontend/web/.env.local and paste these

NEXT_PUBLIC_API_URL=https://REPLACE.execute-api.us-east-1.amazonaws.com/prod
NEXT_PUBLIC_WS_URL=wss://REPLACE.execute-api.us-east-1.amazonaws.com/prod
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_REPLACE
NEXT_PUBLIC_COGNITO_CLIENT_ID=REPLACE_CLIENT_ID
NEXT_PUBLIC_LOCATION_MAP_NAME=nutriroute-prod-map
NEXT_PUBLIC_LOCATION_API_KEY=REPLACE_LOCATION_API_KEY

# ── Frontend Mobile (.env) ────────────────────────────────────────────────────
# Create frontend/mobile/.env and paste these

EXPO_PUBLIC_API_URL=https://REPLACE.execute-api.us-east-1.amazonaws.com/prod
EXPO_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_REPLACE
EXPO_PUBLIC_COGNITO_CLIENT_ID=REPLACE_CLIENT_ID
